# 국가법령정보센터 오픈API 이용자 아이디(OC)
# https://open.law.go.kr 에서 발급받은 값을 넣으세요.
LAW_GO_KR_OC=your_oc_id_here

# 한국부동산원(R-ONE) 통계 오픈API 인증키
# https://www.reb.or.kr 의 R-ONE 오픈API 페이지에서 발급받은 값을 넣으세요.
REB_API_KEY=your_reb_api_key_here

# ── 수전설비 용량 조회 ─────────────────────────────────────────────
# 한국전기안전공사 전기안전정보공개 OpenAPI 인증키(요청 변수 codeNo)
# 전기안전종합정보시스템(https://www.kes.go.kr) > OpenAPI > OpenAPI신청 에서
# '검사점검이력정보'를 신청하면 관리자 승인 후 발급됩니다(활용기간 12개월).
KESCO_API_KEY=

# 기본 조회 기간(개월, 1~60). 정기검사 주기(2년·3년마다 전후 2개월)를 고려한 기본값 38
KESCO_DEFAULT_MONTHS=38

# 월별 API 호출 사이 대기시간(밀리초)
KESCO_REQUEST_DELAY_MS=200

# ── 홈페이지 AI 도우미 (Claude API) ───────────────────────────────
# https://platform.claude.com 에서 발급한 API 키. 질문마다 사용량 요금이 발생합니다.
ANTHROPIC_API_KEY=
# 사용할 모델 (기본 claude-opus-5-5). 비용을 줄이려면 claude-sonnet-5-5 등으로 바꿀 수 있습니다.
ANTHROPIC_MODEL=claude-opus-5-5
# 사고 깊이: low | medium | high | xhigh | max (기본 medium)
ANTHROPIC_EFFORT=medium

# ── 홈페이지 서버 ────────────────────────────────────────────────
# 이 PC(127.0.0.1)에서만 접속할 수 있습니다. 포트만 바꿀 수 있습니다.
PORT=3000
